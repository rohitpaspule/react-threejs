# CDN Configuration
NEXT_PUBLIC_CDN_URL=https://cdn.example.com

# Asset URLs (optional - use CDN for production)
NEXT_PUBLIC_AUDIO_CDN=https://cdn.example.com/audio
NEXT_PUBLIC_MODEL_CDN=https://cdn.example.com/models

# Google Maps API (REQUIRED for satellite map overlay feature)
# Get your key at: https://console.cloud.google.com/google/maps-apis
# Enable: Maps JavaScript API
# Free tier: 28,000 map loads/month
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_api_key_here

# Analytics (optional)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
